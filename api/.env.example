PORT=4000
# Comma-separated list of web origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bitestream

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=BiteStream

DEMO_MODE=false

ORDERS_TABLE=orders
RESTAURANTS_TABLE=restaurants
REVIEWS_COLLECTION=Reviews
MENUS_COLLECTION=Menus
DRIVER_PINGS_COLLECTION=DriverPings
MATERIALIZED_VIEW=restaurant_completed_revenue
